# Container images
GHCR_OWNER=csornyei
HEALTH_API_TAG=latest
MCP_SERVER_TAG=latest
INFLUXDB_TAG=3.9-core
OTEL_COLLECTOR_TAG=latest

# InfluxDB / health API
INFLUXDB_DATABASE=health
# Leave empty for an InfluxDB instance without authentication. If authentication
# is enabled, set a token permitted to read and write INFLUXDB_DATABASE.
INFLUXDB_TOKEN=
HEALTH_API_BIND_ADDRESS=127.0.0.1
HEALTH_API_PORT=8000
# Override only when exporting traces to a collector outside this stack.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ENVIRONMENT=production
LOG_LEVEL=INFO
JSON_LOGS=true
SUMMARY_QUERY_CHUNK_DAYS=1

# MCP server
HEALTH_API_TIMEOUT_SECONDS=30

# OpenAI tunnel client
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
